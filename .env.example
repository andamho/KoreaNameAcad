
# Claude 경로: 기본 claude-code(Max 구독, API 크레딧 불요; Claude Code 설치 + 'claude login' 필요).
#   Anthropic API 방식을 쓰려면 CLAUDE_PROVIDER=api + ANTHROPIC_API_KEY + ANTHROPIC_MODEL.
CLAUDE_PROVIDER=claude-code
CLAUDE_CODE_MAX_TURNS=12

# AI 오케스트레이터(Claude↔GPT 자동 협업) — 실제 키는 .env 에만, 저장소·로그 금지
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_MODEL=
AI_ORCHESTRATOR_MAX_ROUNDS=5
AI_ORCHESTRATOR_DRY_RUN=true
